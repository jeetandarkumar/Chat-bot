{
    "Logging":  {
                    "LogLevel":  {
                                     "Default":  "Information",
                                     "Microsoft.AspNetCore":  "Warning",
                                     "Microsoft.EntityFrameworkCore":  "Information"
                                 }
                },
    "AllowedHosts":  "*",
    "ConnectionStrings":  {
  "DefaultConnection": "Server=DESKTOP-KI6NGEA\\SA;Database=ChatApp;Integrated Security=True;TrustServerCertificate=True;"
                          },
    "Jwt":  {
                "Issuer":  "ChatApp",
                "Audience":  "ChatAppUsers",
                "SecretKey":  "your-super-secret-key-with-at-least-32-characters-for-hmac-sha256",
                "AccessTokenExpirationMinutes":  15,
